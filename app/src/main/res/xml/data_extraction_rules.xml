<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: study history may be backed up, camera footage never is. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="timelapses/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="timelapses/" />
    </device-transfer>
</data-extraction-rules>
